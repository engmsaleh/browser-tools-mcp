{
  "name": "BrowserTools MCP",
  "version": "1.2.0",
  "description": "MCP tool for AI code editors to capture data from a browser such as console logs, network requests, screenshots and more",
  "manifest_version": 2,
  "devtools_page": "devtools.html",
  "permissions": [
    "activeTab",
    "devtools",
    "storage",
    "tabs",
    "webRequest",
    "<all_urls>",
    "scripting",
    "webNavigation"
  ],
  "background": {
    "scripts": ["browser-compat.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browsertools-mcp@agentdesk.ai",
      "strict_min_version": "79.0"
    }
  },
  "web_accessible_resources": [
    "console-proxy.js"
  ],
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg",
    "128": "icons/icon-128.svg"
  }
} 